# Network Configuration
NETWORK_RPC_URL=https://mainnet.infura.io/v3/YOUR-PROJECT-ID
PRIVATE_KEY=your-private-key-here
ETHERSCAN_API_KEY=your-etherscan-api-key

# Token Configuration
TOKEN_NAME=Your Token Name
TOKEN_SYMBOL=TOKEN
INITIAL_SUPPLY=1000000000

# Presale Configuration
UNISWAP_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SOFT_CAP=100              # in ETH
HARD_CAP=500             # in ETH
MIN_CONTRIBUTION=0.1     # in ETH
MAX_CONTRIBUTION=5       # in ETH
PRESALE_PRICE=1000000   # tokens per ETH
PRESALE_DURATION=604800 # 7 days in seconds

# Staking Configuration
REWARD_RATE=100         # rewards per second per token staked (in wei)
MIN_STAKING_PERIOD=86400 # 1 day in seconds

# Gas Reporter Configuration
REPORT_GAS=true
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# Deployment Network (hardhat, localhost, mainnet, testnet)
NETWORK=hardhat
